{
  "name": "semlaengine",
  "version": "0.1.0",
  "description": "A 2D game engine focused on building bullet-heaven / vampire-survivor style games.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:serialization && npm run test:kenning && npm run test:boss && npm run test:collision && npm run test:waves && npm run test:meta",
    "test:serialization": "esbuild scripts/roundtrip-test.mts --bundle --format=esm --platform=node --alias:@engine=./src/engine --alias:@game=./src/game --outfile=.cache/roundtrip.mjs && node .cache/roundtrip.mjs",
    "test:kenning": "esbuild scripts/kenning-test.mts --bundle --format=esm --platform=node --alias:@engine=./src/engine --alias:@game=./src/game --outfile=.cache/kenning.mjs && node .cache/kenning.mjs",
    "test:boss": "esbuild scripts/boss-test.mts --bundle --format=esm --platform=node --alias:@engine=./src/engine --alias:@game=./src/game --outfile=.cache/boss.mjs && node .cache/boss.mjs",
    "test:collision": "esbuild scripts/collision-test.mts --bundle --format=esm --platform=node --alias:@engine=./src/engine --alias:@game=./src/game --outfile=.cache/collision.mjs && node .cache/collision.mjs",
    "test:waves": "esbuild scripts/wave-test.mts --bundle --format=esm --platform=node --alias:@engine=./src/engine --alias:@game=./src/game --outfile=.cache/waves.mjs && node .cache/waves.mjs",
    "test:meta": "esbuild scripts/meta-test.mts --bundle --format=esm --platform=node --alias:@engine=./src/engine --alias:@game=./src/game --outfile=.cache/meta.mjs && node .cache/meta.mjs"
  },
  "keywords": [
    "game-engine",
    "2d",
    "canvas",
    "typescript",
    "vampire-survivors",
    "bullet-heaven",
    "ecs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
